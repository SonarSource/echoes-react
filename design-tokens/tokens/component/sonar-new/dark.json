{
  "echoes": {
    "bottom-scroll": {
      "colors": {
        "shadow": {
          "gradient": {
            "$type": "color",
            "$value": "#ffffff33"
          }
        }
      }
    },
    "form-control": {
      "colors": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{echoes.color.surface.default}"
          },
          "hover": {
            "$type": "color",
            "$value": "{echoes.color.surface.hover}"
          }
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "{echoes.color.border.bolder}"
          },
          "focus": {
            "$type": "color",
            "$value": "{echoes.color.focus.default}"
          }
        },
        "icon": {
          "default": {
            "$type": "color",
            "$value": "{echoes.color.icon.subtle}"
          }
        }
      }
    },
    "logos": {
      "colors": {
        "text": {
          "$type": "color",
          "$value": "{echoes.logos.sonar.colors.text}",
          "$description": "Deprecated, use echoes.logos.sonar.colors.text"
        },
        "brand": {
          "$type": "color",
          "$value": "{echoes.logos.sonar.colors.brand}",
          "$description": "Deprecated, use echoes.logos.sonar.colors.brand"
        },
        "sonar-whale": {
          "$type": "color",
          "$value": "{echoes.logos.sonar.colors.logomark}",
          "$description": "Deprecated, use echoes.logos.sonar.colors.logomark"
        }
      },
      "sonar": {
        "colors": {
          "text": {
            "$type": "color",
            "$value": "#ffffff"
          },
          "brand": {
            "$type": "color",
            "$value": "#ffffff"
          },
          "logomark": {
            "$type": "color",
            "$value": "#d3121d"
          }
        }
      },
      "gitar": {
        "colors": {
          "text": {
            "$type": "color",
            "$value": "#f6ebf8"
          },
          "logomark": {
            "$type": "color",
            "$value": "#f6ebf8"
          }
        }
      }
    },
    "margin-indicator": {
      "colors": {
        "background": {
          "duplication": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.gray.7}"
          },
          "covered": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.green.9}"
          },
          "partially-covered": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.yellow.9}"
          },
          "uncovered": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.red.9}"
          }
        }
      }
    },
    "overlays": {
      "innerShadow": {
        "default": {
          "$type": "boxShadow",
          "$value": {
            "x": "0",
            "y": "-6",
            "blur": "10",
            "spread": "0",
            "color": "#ffffff1a",
            "type": "innerShadow"
          }
        }
      }
    },
    "quality-gate-indicator": {
      "colors": {
        "passed": {
          "icon": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.green.11}"
          },
          "background": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.green.3}"
          }
        },
        "failed": {
          "icon": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.red.11}"
          },
          "background": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.red.3}"
          }
        }
      }
    },
    "ratings": {
      "colors": {
        "background": {
          "ratingA": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.4}"
            }
          },
          "ratingB": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.3}"
            }
          },
          "ratingC": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.yellow.3}"
            }
          },
          "ratingD": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.orange.3}"
            }
          },
          "ratingE": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.3}"
            }
          }
        },
        "text": {
          "ratingA": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.11}"
            }
          },
          "ratingB": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.11}"
            }
          },
          "ratingC": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.yellow.11}"
            }
          },
          "ratingD": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.orange.11}"
            }
          },
          "ratingE": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.11}"
            }
          }
        },
        "border": {
          "ratingA": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.8}"
            },
            "hover": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.9}"
            }
          },
          "ratingB": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.7}"
            },
            "hover": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.green.8}"
            }
          },
          "ratingC": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.yellow.7}"
            },
            "hover": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.yellow.8}"
            }
          },
          "ratingD": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.orange.7}"
            },
            "hover": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.orange.8}"
            }
          },
          "ratingE": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.7}"
            },
            "hover": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.8}"
            }
          }
        }
      }
    },
    "severityBadge": {
      "colors": {
        "background": {
          "severity": {
            "blocker": {
              "prefix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.3}"
                }
              },
              "suffix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.4}"
                },
                "hover": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.5}"
                }
              }
            },
            "high": {
              "prefix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.3}"
                }
              },
              "suffix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.4}"
                },
                "hover": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.red.5}"
                }
              }
            },
            "medium": {
              "prefix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.orange.3}"
                }
              },
              "suffix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.orange.4}"
                },
                "hover": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.orange.5}"
                }
              }
            },
            "low": {
              "prefix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.yellow.3}"
                }
              },
              "suffix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.yellow.4}"
                },
                "hover": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.yellow.5}"
                }
              }
            },
            "info": {
              "prefix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.gray.3}"
                }
              },
              "suffix": {
                "default": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.gray.4}"
                },
                "hover": {
                  "$type": "color",
                  "$value": "{echoes.color.palette.dark.gray.5}"
                }
              }
            }
          }
        },
        "foreground": {
          "blocker": {
            "icon": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.red.11}"
              }
            },
            "text": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.red.11}"
              }
            }
          },
          "high": {
            "text": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.red.11}"
              }
            },
            "icon": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.red.11}"
              }
            }
