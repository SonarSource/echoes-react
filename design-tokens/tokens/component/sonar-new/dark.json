          "medium": {
            "text": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.orange.11}"
              }
            },
            "icon": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.orange.11}"
              }
            }
          },
          "low": {
            "text": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.yellow.11}"
              }
            },
            "icon": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.yellow.11}"
              }
            }
          },
          "info": {
            "text": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.gray.11}"
              }
            },
            "icon": {
              "default": {
                "$type": "color",
                "$value": "{echoes.color.palette.dark.gray.11}"
              }
            }
          }
        },
        "borders": {
          "blocker": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.7}"
            }
          },
          "high": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.red.7}"
            }
          },
          "medium": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.orange.7}"
            }
          },
          "low": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.yellow.7}"
            }
          },
          "info": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.gray.7}"
            }
          }
        }
      }
    },
    "sidebar-navigation": {
      "colors": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.gray.2}"
          }
        }
      }
    },
    "sidebar-navigation-item": {
      "colors": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{echoes.color.roles.support.transparent}"
          },
          "hover": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.gray-alpha.3}"
          },
          "active": {
            "$type": "color",
            "$value": "{echoes.color.palette.dark.gray-alpha.5}"
          }
        }
      }
    },
    "table": {
      "colors": {
        "background": {
          "header": {
            "default": {
              "$type": "color",
              "$value": "{echoes.color.palette.dark.gray.3}"
            }
          }
        }
      }
    }
  }
