{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSameLine": true,
  "printWidth": 100,
  "singleQuote": true,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": [".eslintrc", "tsconfig.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "**/generated",
    "design-tokens/tokens",
    "dist",
    "node_modules",
    ".vscode",
    ".github",
    "netlify.toml",
    "tsconfig.json",
    ".yarn",
    "yarn.lock",
    ".yarnrc.yml",
    ".pnp.*",
    ".jfrog"
  ]
}
