{
  "extends": ["sonarqube"],
  "plugins": ["header"],
  "ignorePatterns": [
    ".github",
    ".yarn",
    "node_modules",
    "dist",
    "build-reports",
    "design-tokens/tokens",
    "storybook-static",
    "src/generated"
  ],
  "rules": {
    // Custom Echoes react config that differs from eslint-config-sonarqube
    "camelcase": "off",
    "no-implicit-coercion": [2, { "boolean": true, "number": true, "string": true }],
    "import/no-default-export": "error",
    "react/jsx-sort-props": "error",
    "react/jsx-pascal-case": [2, { "allowNamespace": true }],
    "react/jsx-no-constructed-context-values": "error",
    "react/jsx-uses-react": "off",
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "react/react-in-jsx-scope": "off",
    "jest/no-large-snapshots": ["error", { "maxSize": 250 }],
    "header/header": ["error", "config/license/LICENSE-HEADER.txt"],

    // New rules added after updating eslint packages to more recent versions than eslint-config-sonarqube
    "jest/prefer-mock-promise-shorthand": "error",
    "promise/catch-or-return": ["warn", { "allowThen": true, "allowFinally": true }]
  },
  "overrides": [
    {
      // react-router-dom is a dev dependency only: library code must go through the router adapter
      "files": ["src/**"],
      "excludedFiles": [
        "src/common/helpers/react-router-adapter.ts",
        "**/test-utils.tsx",
        "**/test-utils/**",
        "**/__tests__/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-router-dom",
                "message": "Echoes must not depend on react-router-dom, use RouterLink and usePathname from src/components/router/RouterContext instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*-stories.tsx", "vite.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["config/scripts/*","design-tokens/build.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["config/scripts/migrations/*", "**/*.snap"],
      "rules": {
        "header/header": "off"
      }
    }
  ]
}
